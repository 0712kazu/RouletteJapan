{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": ".build"
  },
  "include": ["src/**/*.ts"]
}
