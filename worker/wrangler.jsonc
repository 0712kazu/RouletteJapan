{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roulette-japan-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roulette-japan",
      "database_id": "REPLACE_WITH_EXISTING_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://0712kazu.github.io"
  }
}
